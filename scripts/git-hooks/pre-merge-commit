#!/bin/sh
# Refuse to merge a base line (BASE_LINES in check_no_base_merges.py) into a feature branch.
# Installed by scripts/install-git-hooks.sh; see scripts/check_no_base_merges.py.
# A merge that stops on conflicts is concluded by "git commit", so the same
# check also runs from the pre-commit hook while a merge is in progress.
# The installer copies the check next to this hook (into the directory git
# uses for hooks, core.hooksPath included), so it applies on every branch,
# including branches that do not contain scripts/ yet.
check="$(git rev-parse --git-path hooks)/check_no_base_merges.py"
if [ ! -f "$check" ]; then
    echo "pre-merge-commit: $check missing; run scripts/install-git-hooks.sh" >&2
    exit 1
fi
for py in python3 python; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys; sys.exit(sys.version_info < (3, 6))" >/dev/null 2>&1; then
        exec "$py" "$check" --pending
    fi
done
echo "pre-merge-commit: no Python 3.6+ found; base-merge check skipped" >&2
exit 0
