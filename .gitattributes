# Every file is text with LF line endings on every platform, whatever the
# local core.autocrlf says (as in the viewer repository). Files that are not
# text are marked below.
* text eol=lf

# Test fixtures are compared byte for byte: stored and checked out as is.
crates/*/tests/fixtures/** -text

# Recorded message corpus (vkstorm-messages)
*.vksm binary
# Recorded parity corpora (vkstorm-assets): stored as is
*.vksa binary
crates/*/tests/fixtures/*.bin binary
# JPEG 2000 fixtures and the C fork's reference outputs (vkstorm-openjp2, vkstorm-j2c)
*.j2c binary
*.j2k binary
*.opj.raw binary
# Audio fixtures (vkstorm-vorbis, vkstorm-audio)
*.ogg binary
*.oga binary
*.ogv binary
*.opus binary
*.mp2 binary
*.mp3 binary
*.aac binary
*.flac binary
*.m4a binary
*.mp4 binary
*.wav binary
# One-way merge guard: hooks and scripts run as is on every platform
scripts/** text eol=lf
